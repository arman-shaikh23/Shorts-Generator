GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URL=mongodb://localhost:27017
DB_NAME=realestate_shorts

# Mongo pool profile: small deployment (single node / low concurrency)
MONGO_MAX_POOL_SIZE=30
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=8000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# HTTP pool profile: small deployment
HTTP_POOL_MAX_CONNECTIONS=40
HTTP_POOL_MAX_KEEPALIVE_CONNECTIONS=10
HTTP_CONNECT_TIMEOUT_SEC=10.0
HTTP_READ_TIMEOUT_SEC=300.0
HTTP_WRITE_TIMEOUT_SEC=30.0
HTTP_POOL_TIMEOUT_SEC=20.0
UPLOAD_STREAM_CHUNK_SIZE=1048576
MAX_VIDEO_UPLOAD_BYTES=10737418240
MAX_MUSIC_UPLOAD_BYTES=104857600
YTDLP_COOKIES_FILE=
YOUTUBE_MAX_DURATION_SEC=0
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=40
REDIS_CONNECT_TIMEOUT_SEC=2.0
REDIS_READ_TIMEOUT_SEC=2.0
CACHE_DEFAULT_TTL_SEC=60
CACHE_TTL_PROJECTS_SEC=60
CACHE_TTL_PROJECT_DETAIL_SEC=60
CACHE_TTL_HISTORY_SEC=90
CACHE_TTL_UPLOADS_SEC=30
CACHE_TTL_DASHBOARD_STATS_SEC=30
CACHE_TTL_MUSIC_LIBRARY_SEC=300
CACHE_VERSION_TTL_SEC=2592000

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reel quality V2 safe defaults (legacy behavior preserved)
PIPELINE_SHADOW_MODE=false
ENABLE_STABILITY_V2=false
ENABLE_TRIM_V2=false
ENABLE_STORY_V2=false
ENABLE_SCORING_V2=false
ENABLE_DEDUP_V2=false
ENABLE_TRANSITION_V2=false
V2_MIN_TRIM_CONFIDENCE=0.6
V2_MIN_STORY_CONFIDENCE=0.55
V2_STABILITY_WEIGHT=0.15
V2_CINEMATIC_WEIGHT=0.15
V2_STORY_WEIGHT=0.10
V2_ROOM_UNIQUENESS_WEIGHT=0.05
V2_TRANSITION_WEIGHT=0.05
