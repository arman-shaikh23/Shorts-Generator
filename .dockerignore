# Frontend local build/deps
frontend/node_modules
frontend/dist

# E2E artifacts/deps (not needed for image build)
e2e_tests/node_modules
e2e_tests/playwright-report
e2e_tests/test-results

# Misc local/generated folders
scratch
observability

