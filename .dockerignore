# VCS and local agent metadata
.git
.github
.agents

# Python virtualenv / caches
backend/venv
backend/.pytest_cache
**/__pycache__
**/*.pyc
**/*.pyo

# Local runtime data (very large / generated)
backend/data
backend/downloads
backend/outputs
backend/logs

# Local secrets (pass these via env vars in deployment)
backend/.env
backend/.env.*
